{
  "name": "sapphire-stock",
  "version": "1.0.0",
  "description": "Sapphire bar stock management",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/@supabase/supabase-js/dist/umd/supabase.js','web/vendor/supabase.js')\""
  },
  "author": "Sapphire",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.117.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Sapphire Stock",
  "private": true,
  "build": {
    "appId": "com.sapphire.stock",
    "productName": "Sapphire Stock",
    "directories": {
      "output": "release"
    },
    "files": [
      "web/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sapphire Stock",
      "artifactName": "Sapphire Stock Setup ${version}.${ext}"
    }
  }
}
